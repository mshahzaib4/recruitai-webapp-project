{
    "version": 2,
    "builds": [
          {
                  "src": "api/index.py",
                  "use": "@vercel/python"
          },
          {
                  "src": "frontend/**",
                  "use": "@vercel/static"
          }
    ],
    "routes": [
          {
                  "src": "/api/(.*)",
                  "dest": "/api/index.py"
          },
          {
                  "src": "/upload.html",
                  "dest": "/frontend/upload.html"
          },
          {
                  "src": "/results.html",
                  "dest": "/frontend/results.html"
          },
          {
                  "src": "/about.html",
                  "dest": "/frontend/about.html"
          },
          {
                  "src": "/css/(.*)",
                  "dest": "/frontend/css/$1"
          },
          {
                  "src": "/js/(.*)",
                  "dest": "/frontend/js/$1"
          },
          {
                  "src": "/assets/(.*)",
                  "dest": "/frontend/assets/$1"
          },
          {
                  "src": "/(.*)",
                  "dest": "/frontend/$1"
          }
    ]
}
